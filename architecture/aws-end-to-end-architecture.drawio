        <mxCell id="node_ecs_worker" value="Amazon ECS Fargate (Worker Service)&#xa;Celery Distributed Inference Worker&#xa;• Stage 1: RTMDet-Tiny (Bounding Box)&#xa;• Stage 1.5: Adaptive Signature Cropper&#xa;• Stage 2: Siamese ResNet-50 Verifier&#xa;  (256-D Embedding + Cosine Distance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="group_vpc">
