# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Signature Detection & Verification System"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=signature_verification_db
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/signature_verification_db

# RabbitMQ / Celery Broker Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=signature-verification-pipeline

# Storage / Artifact Paths
MODEL_STORAGE_PATH=./mlruns
ARTIFACT_STORAGE_PATH=./data/processed
UPLOAD_TEMP_DIR=./uploads_tmp
